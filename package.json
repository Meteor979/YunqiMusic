{
  "name": "yunqi-music",
  "version": "0.4.4",
  "description": "A focused multi-source desktop music player for NetEase Cloud Music, Kugou Music, QQ Music, and Qishui Music.",
  "author": "Yunqi Music",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meteor979/YunqiMusic.git"
  },
  "packageManager": "pnpm@11.25.0",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack:dir": "electron-builder --dir",
    "update:assets": "node scripts/make-update-assets.js",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "NeteaseCloudMusicApi": "4.32.0",
    "axios": "^1.1.3",
    "big-integer": "^1.6.52",
    "crypto-js": "^4.2.0",
    "node-forge": "1.4.1",
    "pako": "^2.1.0",
    "qishui-music-api": "0.2.2",
    "qqmusic-api-enhanced": "1.0.8",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.yunqi.music",
    "productName": "云栖音乐",
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "vendor/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ],
      "artifactName": "Yunqi-Music-${version}-portable.${ext}"
    }
  }
}
